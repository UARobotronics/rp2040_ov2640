.program image_2_bit
.wrap_target
	wait 1 pin 3 // wait for hsync
	wait 1 pin 2 // wait for rising pclk
	in pins 2
	wait 0 pin 2
	wait 1 pin 2 // wait for rising pclk
	in null 6 // 8 - number_of_pins
	wait 0 pin 2
.wrap

% c-sdk {
void image_2_bit_program_init(PIO pio, uint sm, uint offset, uint pin_base)
{
	pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 10, false);

	pio_sm_config c = image_2_bit_program_get_default_config(offset);
	// 6 least significant bits of data are ignored
	sm_config_set_in_pins(&c, pin_base + 6);
	//sm_config_set_in_pins(&c, pin_base);
	sm_config_set_in_shift(&c, false, true, 8);
	sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

	pio_sm_init(pio, sm, offset, &c);
	pio_sm_set_enabled(pio, sm, true);
}
%}
