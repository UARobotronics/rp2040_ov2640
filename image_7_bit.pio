.program image_7_bit
.wrap_target
	wait 1 pin 8 // wait for hsync
	wait 1 pin 7 // wait for rising pclk
	in pins 7
	wait 0 pin 7
	wait 1 pin 7 // wait for rising pclk
	in null 1 // 8 - number_of_pins
	wait 0 pin 7
.wrap

% c-sdk {
void image_7_bit_program_init(PIO pio, uint sm, uint offset, uint pin_base)
{
	pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 10, false);

	pio_sm_config c = image_7_bit_program_get_default_config(offset);
	// 1 least significant bit of data is ignored
	sm_config_set_in_pins(&c, pin_base + 1);
	//sm_config_set_in_pins(&c, pin_base);
	sm_config_set_in_shift(&c, false, true, 8);
	sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

	pio_sm_init(pio, sm, offset, &c);
	pio_sm_set_enabled(pio, sm, true);
}
%}
